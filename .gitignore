# Dependencies
node_modules/

# Build output
dist/
/backend/dist/
/frontend/dist/
/shared/dist/

# Angular
.angular/
/frontend/.angular/

# Environment / secrets (NEVER commit real connection strings)
.env
.env.local
*.env
!.env.example
backend/.env
# Hand-made copies of the box's deploy/.env (e.g. .env.bak-<epoch>) hold the same secrets
deploy/.env.*
!deploy/.env.example

# Deploy state the box writes next to the scripts (deploy.sh, auto-deploy.sh)
deploy/.deployed-*
deploy/.autodeploy-*

# Local MCP config (may contain the Atlas URI with credentials)
.mcp.json

# Self-host backups & encryption keys (NEVER commit — dumps hold emails + password hashes)
deploy/backups/
*.age
age-key.txt
*.agekey

# Logs
*.log
npm-debug.log*

# Coverage / tests
coverage/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
