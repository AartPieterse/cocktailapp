# --- deploy/.env — Barkaart self-host secrets ---
# Copy to deploy/.env and fill in real values. deploy/.env is gitignored; NEVER commit it.

# MongoDB root credentials (the api assembles MONGODB_URI from these).
# Use a long random password. It MUST be URI-safe: the compose file interpolates it straight into
# mongodb://USER:PASSWORD@mongo:27017/... , and base64's + / = characters make the driver fail with
# "MongoParseError: Password contains unescaped characters". Use `openssl rand -hex 32`.
MONGO_USER=barkaart
MONGO_PASSWORD=change-me-long-random
MONGO_DB=barkaart

# JWT signing secrets — TWO DIFFERENT high-entropy values (`openssl rand -base64 48`).
# The API refuses to boot if these are equal.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS allowlist — the web origin(s), comma-separated. REQUIRED (prod boots with NODE_ENV=production).
CORS_ORIGIN=https://barkaart.example

# --- Deploy (deploy/deploy.sh, deploy/auto-deploy.sh) ---
# The two GHCR images the box pulls for a release. Must match the CI-published packages (lowercase
# owner). Both must be public, or the box must `docker login ghcr.io`.
IMAGE_REPO=ghcr.io/aartpieterse/barkaart-api
WEB_IMAGE_REPO=ghcr.io/aartpieterse/barkaart-web

# --- LAN admin dashboard (analytics/metrics at /api/admin/*) ---
# Basic-auth creds, fail-closed. Publish the API to the LAN with docker-compose.admin.yml (see
# deploy/README.md §8), then open http://aartfileserver.local:8080/api/admin/dashboard on the home
# network. Basic-auth is the ONLY real protection today: the guard's "LAN-only" check looks for a
# Cloudflare header that no longer arrives (docs/plans/public-access.md §2).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-long-random

# --- Backups (deploy/backup.sh) ---
# age recipient PUBLIC key (encrypt-to). Keep the matching PRIVATE key OFF this box.
AGE_RECIPIENT=age1examplexxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where encrypted dumps are written, and how many newest to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14
