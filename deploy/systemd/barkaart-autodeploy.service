# Barkaart automatic pull-deploy — one-shot, fired by barkaart-autodeploy.timer.
#
# The box has no inbound ports, so a release cannot be pushed to it: it must be PULLED. This unit is
# that pull. It checks the GHCR API image and the release branch's SPA source independently, and
# deploys whichever moved.
#
# Install (paths below match the reference host: user `aart`, checkout at ~/cocktailapp):
#   sudo cp deploy/systemd/barkaart-autodeploy.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now barkaart-autodeploy.timer
# Inspect:
#   systemctl list-timers barkaart-autodeploy.timer
#   journalctl -u barkaart-autodeploy.service -f
#   sudo systemctl start barkaart-autodeploy.service   # force a cycle now
[Unit]
Description=Barkaart auto-deploy (pull the new API image from GHCR, rebuild the SPA, roll out)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Must be in the `docker` group (or use rootless docker). Adjust both paths if your checkout differs.
User=aart
WorkingDirectory=/home/aart/cocktailapp/deploy
# Invoked via bash so it runs regardless of the file's exec bit (the script is authored on a
# platform that doesn't track the +x mode). auto-deploy.sh reads the shebang either way.
ExecStart=/bin/bash /home/aart/cocktailapp/deploy/auto-deploy.sh
# npm ci plus an Angular production build is minutes, and a roll-out adds an encrypted backup and
# migrations on top. Don't let systemd kill a release half-way.
TimeoutStartSec=3600
