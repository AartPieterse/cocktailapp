# Poll for a new release shortly after boot, then hourly.
#
# Hourly rather than every few minutes on purpose: `main` is the stable branch and merges into it are
# rare, so a shorter interval buys nothing but wakes the box for no reason. A cycle that finds nothing
# costs a `git fetch` and a registry digest check — a few kilobytes — so the interval controls only how
# long a release sits unnoticed, not the running cost. Widen OnUnitActiveSec freely; the deploy path
# is identical whether it fires hourly or daily.
[Unit]
Description=Poll for a new Barkast release (GHCR API image + SPA source) and auto-deploy

[Timer]
OnBootSec=2min
OnUnitActiveSec=1h
# If the box was off or asleep when a run was due, fire once on wake instead of skipping it. This box
# is a laptop on a home connection, so missed windows are normal rather than exceptional.
Persistent=true

[Install]
WantedBy=timers.target
