# LAN preview of the SPA. Static files only — no /api proxy, deliberately.
#
# The production Angular build has authEnabled: false and reads its catalog from the bundled
# catalog.json, so it makes no API calls at all. Serving it needs nothing but a file server, and
# leaving the API unpublished keeps the LAN surface at zero.
#
# When the same-origin deploy lands (docs/plans/next-phase.md step 8) this gains a
# `handle /api/* { reverse_proxy api:3000 }` block and moves behind the tunnel for TLS.
:80 {
	root * /srv
	encode gzip zstd

	# Angular routes are client-side: anything that is not a real file must return index.html,
	# or a reload on /ontdek 404s. Mirrors frontend/public/_redirects, which only Netlify reads.
	try_files {path} /index.html
	file_server

	# Caching, in two non-overlapping halves.
	#
	# Matching `/index.html` by path was a trap: the browser asks for `/` or `/ontdek`, never for
	# `/index.html`, so the no-cache header landed on nothing and every entry point was served with no
	# cache directive at all. Browsers then fall back to heuristic caching off Last-Modified, and a
	# phone will happily hold a stale HTML shell for days — which pins it to the old hashed bundles the
	# shell names, so the whole app stays on the previous release.
	#
	# So: cache the hashed assets forever (their name changes when they change), and tell the browser
	# to revalidate everything else — the shell, catalog.json, the manifest.
	#
	# The separator is a HYPHEN, not a dot: Angular's esbuild builder emits `styles-SBPBZZX4.css` and
	# `chunk-3N2XJ7NA.js`. A pattern written for `name.HASH.ext` matches none of them, which silently
	# turns the immutable-asset rule into dead config — it was written that way and never fired.
	@hashed path_regexp [.-][0-9A-Z]{8,}\.(js|css|woff2?)$
	@unhashed not path_regexp [.-][0-9A-Z]{8,}\.(js|css|woff2?)$
	header @hashed   Cache-Control "public, max-age=31536000, immutable"
	header @unhashed Cache-Control "no-cache"

	log {
		output stderr
		format console
	}
}
